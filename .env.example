# ==============================================================================
# LK Gloss & Detail — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Note: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage, pgvector)
# ------------------------------------------------------------------------------
# Project URL from Supabase dashboard (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Publishable / Anon Key (Safe for client-side usage)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Alias for compatibility with standard Supabase clients
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Privileged Service Role Key (Backend / Server Actions / Admin Scripts ONLY)
# WARNING: NEVER expose this key to client-side code or public repositories!
SUPABASE_SECRET_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. OpenRouter (AI Models: Gemini 2.5 Pro, GPT-4o-mini, Gemini 2.5 Flash, Embeddings)
# ------------------------------------------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ------------------------------------------------------------------------------
# 3. Resend (Transactional Email Notifications)
# ------------------------------------------------------------------------------
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key

# Recipient email for customer inquiries from the contact form
CONTACT_EMAIL=info@lkglossanddetail.de

# ------------------------------------------------------------------------------
# 4. Domain & Deployment URLs
# ------------------------------------------------------------------------------
# Base URL of the website (used for metadata, OpenGraph, and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel deployment variables (automatically provided in Vercel production)
# NEXT_PUBLIC_VERCEL_URL=
# VERCEL_PROJECT_PRODUCTION_URL=

# ------------------------------------------------------------------------------
# 5. Initial Admin Credentials (Optional — used by scripts/create-admin.ts)
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@lkglossanddetail.de
ADMIN_PASSWORD=your-secure-admin-password

# ------------------------------------------------------------------------------
# 6. LangSmith Tracing (Optional — for LLM monitoring and debugging)
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lk-gloss-detail
